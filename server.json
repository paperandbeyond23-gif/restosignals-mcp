{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.restosignals/restosignals",
  "title": "RestoSignals",
  "description": "Pre-opening US restaurant and bar leads, scored from liquor, permit and business filings.",
  "version": "1.0.0",
  "websiteUrl": "https://restosignals.com",
  "repository": {
    "url": "https://github.com/paperandbeyond23-gif/restosignals-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.restosignals.com/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "RestoSignals API key (free at restosignals.com/signup)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}